# Only needed for manual BSC testnet deployment. Never put real values in Git.
BSC_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com
PUBLIC_RPC_URL=https://bsc-testnet-rpc.publicnode.com
DEPLOYMENT_FILE=deployments/testnet.json
# 300: accelerated test epochs; 86400: UTC+8 daily accounting. Immutable after deployment.
RASUN_EPOCH_SECONDS=300
DEPLOYER_PRIVATE_KEY=
MINER_ADDRESS=
LIQUIDITY_ADDRESS=
TECH_ADDRESS=
OPERATIONS_ADDRESS=
DAO_ADDRESS=
STABILIZATION_ADDRESS=
# Sandbox MINER_ADDRESS and LIQUIDITY_ADDRESS default to deployer; leave blank.
# Uses worthless tUSDT and a test pool/oracle. Not real USDT or a production DEX.
