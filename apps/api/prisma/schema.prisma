generator client {
  provider = "prisma-client-js"
  engineType = "client"
}
datasource db {
  provider = "sqlite"
  url = "file:./dev.db"
}
model ChainEvent {
  id Int @id @default(autoincrement())
  scope String
  txHash String
  logIndex Int
  blockNumber Int
  blockHash String
  contractAddress String
  name String
  args String
  account1 String?
  account2 String?
  timestamp Int
  @@unique([scope, txHash, logIndex])
  @@index([scope, blockNumber])
  @@index([scope, account1])
  @@index([scope, account2])
}
model IndexedBlock {
  id Int @id @default(autoincrement())
  scope String
  number Int
  hash String
  @@unique([scope, number])
}
