generator client { provider = "prisma-client-js" }
datasource db { provider = "sqlite"; url = env("DATABASE_URL") }
model User { id Int @id @default(autoincrement()) walletAddress String @unique; createdAt DateTime @default(now()); referrals Referral[] @relation("Inviter") }
model Referral { id Int @id @default(autoincrement()); inviterId Int; inviteeAddress String @unique; blockNumber String; txHash String @unique; inviter User @relation("Inviter", fields:[inviterId], references:[id]) }
model TokenTransfer { id Int @id @default(autoincrement()); txHash String; logIndex Int; fromAddress String; toAddress String; amountWei String; blockNumber String; @@unique([txHash,logIndex]) }
model BalanceSnapshot { id Int @id @default(autoincrement()); walletAddress String; snapshotDay String; balanceWei String; rank Int?; @@unique([walletAddress,snapshotDay]) }
model RewardSnapshot { id Int @id @default(autoincrement()); walletAddress String; snapshotDay String; rewardType String; amountWei String; merkleRoot String?; @@unique([walletAddress,snapshotDay,rewardType]) }
model ClaimRecord { id Int @id @default(autoincrement()); walletAddress String; rewardType String; amountWei String; txHash String @unique; blockNumber String }
model BlockSyncState { id Int @id @default(autoincrement()); key String @unique; lastBlock String }
model AdminUser { id Int @id @default(autoincrement()); username String @unique; passwordHash String; createdAt DateTime @default(now()) }
model AuditLog { id Int @id @default(autoincrement()); action String; actor String; details String?; createdAt DateTime @default(now()) }
